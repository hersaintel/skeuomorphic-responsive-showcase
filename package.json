{
  "name": "skeuomorphic-responsive-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A responsive modern-skeuomorphic interface showcase.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node tools/capture-screenshots.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
